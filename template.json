{
    "templateId": "horizon-europe-dmp-norway",
    "organizationId": "research.data.no",
    "version": "1.0.0",
    "name": "Horizon Europe DMP",
    "description": "Data Management Plan according to the Horizon Europe template, based on the Norwegian generic knowledge model",
    "license": "Apache-2.0",
    "metamodelVersion": "18.1",
    "allowedPackages": [
        {
            "orgId": "research.data.no",
            "kmId": "norway-generic",
            "minVersion": "1.2.1",
            "maxVersion": null
        }
    ],
    "formats": [
        {
            "uuid": "aedbc0c8-e35d-4bfb-9aa5-f630b75dd047",
            "name": "HTML Document",
            "icon": "far fa-file-code",
            "steps": [
                {
                    "name": "jinja",
                    "options": {
                        "template": "src/index.html.j2",
                        "content-type": "text/html",
                        "extension": "html"
                    }
                }
            ]
        },
        {
            "uuid": "7077a3f8-44a5-4dce-bf32-db1d6db5cf9a",
            "name": "PDF Document",
            "icon": "far fa-file-pdf",
            "steps": [
                {
                    "name": "jinja",
                    "options": {
                        "template": "src/index.html.j2",
                        "content-type": "text/html",
                        "extension": "html"
                    }
                },
                {
                    "name": "weasyprint",
                    "options": {}
                }
            ]
        },
        {
            "uuid": "729e9fee-fef3-483f-8965-815fc25060a6",
            "name": "MS Word Document",
            "icon": "far fa-file-word",
            "steps": [
                {
                    "name": "jinja",
                    "options": {
                        "template": "src/word/index.html.j2",
                        "content-type": "text/html",
                        "extension": "html"
                    }
                },
                {
                    "name": "pandoc",
                    "options": {
                        "from": "html",
                        "to": "docx",
                        "args": "--filter=pandoc-docx-pagebreakpy --reference-doc=src/word/reference.docx"
                    }
                }
            ]
        }
    ],
    "_tdk": {
        "version": "4.28.0",
        "readmeFile": "README.md",
        "files": [
            "assets/*",
            "src/*",
            "src/**/*",
            "!tools/",
            "!.git/",
            "!.env",
            "!**/__pycache__/"
        ]
    }
}
