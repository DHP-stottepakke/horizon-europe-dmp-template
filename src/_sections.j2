  },
  {
    "id": "sec-other-issues",
    "title": "7. Other issues",
    "blocks": [
      {
        "anchors": [
          "administrativeInformation.institutionalPoliciesGuidelines",
          "administrativeInformation.didConsultResearch",
          "administrativeInformation.haveMadePlans",
