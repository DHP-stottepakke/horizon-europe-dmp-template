{#- Contributors are navigated by json.key annotation, see _renderers for the rest. -#}
{%- set contributorItems = replies.administrativeInformation.contributors if replies.administrativeInformation else [] -%}
<div id="dmp-contributors">
  <h2>Contributors</h2>

  <p>The following contributors are related to the project of this DMP:</p>

  {%- set contributors = [] -%}
  {%- for item in contributorItems -%}
    {%- set name = item.name._value if item.name else "" -%}
    {%- if name -%}
      {%- do contributors.append({
        'name': name,
        'email': item.email._value if item.email else "",
        'orcid': item.orcid._value if item.orcid else "",
        'affiliation': item.affiliation._value if item.affiliation else "",
        'roles': (item.roles|map(attribute='_label')|list|sort) if item.roles else [],
      }) -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if contributors|length > 0 -%}
  <ul>
  {% for contributor in contributors %}
    <li class="contributor">
      <span class="name">{{ contributor.name }}</span>
      {%- if contributor.email %}
        <br><a href="mailto:{{ contributor.email }}">{{ contributor.email }}</a>
      {%- endif -%}
      {#- ORCID and affiliation come from integrations, so their markdown is unwrapped
          to stay on the line the <br> started; see globals.mdInline. -#}
      {%- if contributor.orcid %}
        <br>{{ globals.mdInline(contributor.orcid) }}
      {%- endif -%}
      {%- if contributor.roles|length > 0 %}
        <br>{% if contributor.roles|length == 1 %}Role{% else %}Roles{% endif %}: {% for role in contributor.roles %}<span class="role">{{ role }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
      {%- endif %}
      {%- if contributor.affiliation %}
        <br>Affiliation: <span class="affiliation">{{ globals.mdInline(contributor.affiliation) }}</span>
      {%- endif %}
    </li>
  {% endfor %}
  </ul>
  {%- elif dc.project.created_by -%}
  <ul>
    <li class="contributor">
      <span class="name">{{ dc.project.created_by.first_name }} {{ dc.project.created_by.last_name }}</span>
      <br><a href="mailto:{{ dc.project.created_by.email }}">{{ dc.project.created_by.email }}</a>
      {%- if dc.project.created_by.affiliation %}
      <br>Affiliation: <span class="affiliation">{{ dc.project.created_by.affiliation }}</span>
      {%- endif %}
    </li>
  </ul>
  {%- else -%}
  <div style="font-style:italic;">There are no contributors described for this DMP.</div>
  {%- endif -%}
</div>
