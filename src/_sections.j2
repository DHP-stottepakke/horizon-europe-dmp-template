          "responsibilitiesResourcesChapter.recurringFees",
          "responsibilitiesResourcesChapter.totalCostsManagement"
        ]
      }
    ]
  },
  {
    "id": "sec-data-security",
    "title": "5. Data security",
    "blocks": [
      {
        "anchors": [
          "storingProtectingChapter.storageGuidelinesFollowing",
          "storingProtectingChapter.storeDocuments",
          "processingDataChapter.processingAffectInformation",
          "storingProtectingChapter.workTogetherDocuments",
          "processingDataChapter.monitorIntegrity",
          "processingDataChapter.fileVersioningDocs",
          "storingProtectingChapter.dataLossLeakVandalismRisks"
        ]
      }
    ]
  },
  {
    "id": "sec-ethical-aspects",
    "title": "6. Ethics",
    "blocks": [
      {
        "anchors": [
          "legalEthicalAspectsChapter.requiresEthicalApproval",
          "legalEthicalAspectsChapter.personalCollectedProcessed",
          "legalEthicalAspectsChapter.sensitiveInformationThan",
