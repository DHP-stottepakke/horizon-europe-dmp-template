{%- import "src/_sections.j2" as skeleton with context -%}
<div id="dmp-content">
  {%- for section in skeleton.sections %}
  <section id="{{ section.id }}" class="dmp-section">
    <h2>{{ section.title }}</h2>
    {%- for block in section.blocks %}
    {#- Capture first so a block whose anchors are all absent from the knowledge
        model does not leave a dangling heading behind. -#}
    {%- set rendered %}
      {%- for key in block.anchors %}{{ renderers.renderByKey(kmIndex.qidx, key) }}{% endfor -%}
    {% endset -%}
    {%- if rendered|trim %}
    {%- if block.heading %}
    <h3>{{ block.heading }}</h3>
    {%- endif %}
    {{ rendered }}
    {%- endif %}
    {%- endfor %}
  </section>
  {%- endfor %}
</div>
