{#-
  Project metadata. The Norwegian knowledge model holds one project per DMP, with
  the description spread over three mutually exclusive answers of "Project
  description" and funding kept under "Did you ... apply for external funding?".
-#}
{%- set project = replies.researchProjectChapter -%}
{%- set fundings = project.didPlanApply.fundings if project and project.didPlanApply and project.didPlanApply.fundings else [] -%}
<div id="dmp-projects">
  <h2>Project</h2>

  <p>We will be working on the following project and for that are the data and work described in this DMP.</p>

  {%- if project -%}
    <div class="project">
    {%- if globals.projectName -%}
      <h3>{{ globals.projectName }}</h3>
    {%- else -%}
      <h3 class="empty-value">(project name not given)</h3>
    {%- endif -%}

      <dl>
        <dt>Start date</dt>
        <dd>{{ project.startDate._value if project.startDate else "N/A" }}</dd>
        <dt>End date</dt>
        <dd>{{ project.endDate._value if project.endDate else "N/A" }}</dd>
        <dt>Funding</dt>
        <dd>
          {%- if fundings|length > 0 %}
            <ul>
            {%- for funding in fundings %}
              <li>
                {{ funding.funder._value|markdown if funding.funder else "(funder not given)" }}
                {%- if funding.grantNumber and funding.grantNumber._value %}: {{ funding.grantNumber._value }}{% else %}: grant number not yet given{% endif %}
                {%- if funding.status %} ({{ funding.status._label|lower }}){% endif %}
                {%- if funding.titleAcronymGrant and funding.titleAcronymGrant._value %}<br>{{ funding.titleAcronymGrant._value }}{% endif %}
              </li>
            {%- endfor %}
            </ul>
          {%- else -%}
            Did not apply for any funding yet.
          {%- endif -%}
        </dd>
      </dl>

    {#- The description answer decides which follow-up carries the text or link. -#}
    {%- set description = project.abstract -%}
    {%- if description -%}
      {%- set abstractText = (description.enterAbstractDescription2._value if description.enterAbstractDescription2 else "")
        or (description.enterAbstractDescription._value if description.enterAbstractDescription else "")
        or (description.linkExternalInformation._value if description.linkExternalInformation else "") -%}
      {%- if abstractText %}
      <section class="abstract">
        {{ abstractText|markdown }}
      </section>
      {%- endif -%}
    {%- endif -%}
    </div>
  {%- else -%}
    <div style="font-style:italic;">There is no project described for this DMP.</div>
  {%- endif -%}
</div>
